<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageVersion Include="Avalonia"                       Version="12.1.*" />
    <PackageVersion Include="Avalonia.Desktop"               Version="12.1.*" />
    <PackageVersion Include="Avalonia.Themes.Fluent"         Version="12.1.*" />
    <PackageVersion Include="Avalonia.Controls.DataGrid"     Version="12.1.*" />
    <PackageVersion Include="Avalonia.Fonts.Inter"           Version="12.1.*" />
    <!-- EF Core + SQLite -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore"          Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite"   Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools"    Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection"   Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Hosting"               Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions"  Version="10.0.*" />
    <!-- Logging to a file. Microsoft.Extensions.Logging has no built-in file provider. -->
    <PackageVersion Include="Serilog.Extensions.Logging"                 Version="10.0.*" />
    <PackageVersion Include="Serilog.Sinks.File"                         Version="7.0.*" />
    <!-- MVVM Toolkit -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.*" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"          Version="18.11.0" />
    <PackageVersion Include="xunit"                           Version="2.9.*" />
    <PackageVersion Include="xunit.runner.visualstudio"       Version="4.0.1" />
    <PackageVersion Include="coverlet.collector"              Version="10.1.*" />
    <PackageVersion Include="NSubstitute"                     Version="5.3.0" />
    <PackageVersion Include="FluentAssertions"                Version="8.11.0" />
    <!-- Headless UI testing. Avalonia.Headless.XUnit targets xunit v3, so the App test
         project uses v3 while QemuXplorer.Core.Tests stays on v2. -->
    <PackageVersion Include="xunit.v3"                        Version="3.2.*" />
    <PackageVersion Include="Avalonia.Headless.XUnit"         Version="12.1.*" />
  </ItemGroup>

</Project>
