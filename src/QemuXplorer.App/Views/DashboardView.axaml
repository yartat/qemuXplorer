<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QemuXplorer.App.ViewModels"
             x:Class="QemuXplorer.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{DynamicResource AppCanvas}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <Border Grid.Row="0"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
            Height="46" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="pageTitle" Text="Dashboard"/>
        <Button Grid.Column="2" Classes="tool" Content="Refresh"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"/>
      </Grid>
    </Border>

    <!-- Counters -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="16" ColumnSpacing="12">
      <Border Grid.Column="0" Background="{DynamicResource AppSurface}"
              BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
              CornerRadius="5" Padding="16,14">
        <StackPanel Spacing="5">
          <TextBlock Classes="section" Text="RUNNING"/>
          <TextBlock Text="{Binding RunningCount}" FontSize="26"
                     FontFamily="{DynamicResource AppMonoFont}"
                     Foreground="{DynamicResource AppOk}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource AppSurface}"
              BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
              CornerRadius="5" Padding="16,14">
        <StackPanel Spacing="5">
          <TextBlock Classes="section" Text="DEFINED"/>
          <TextBlock Text="{Binding DefinedCount}" FontSize="26"
                     FontFamily="{DynamicResource AppMonoFont}"
                     Foreground="{DynamicResource AppText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource AppSurface}"
              BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
              CornerRadius="5" Padding="16,14">
        <StackPanel Spacing="5">
          <TextBlock Classes="section" Text="ALLOCATED MEMORY"/>
          <TextBlock Text="{Binding AllocatedMemory}" FontSize="26"
                     FontFamily="{DynamicResource AppMonoFont}"
                     Foreground="{DynamicResource AppText}"/>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Classes="section" Text="RUNNING MACHINES" Margin="16,0,16,8"/>

    <DataGrid Grid.Row="3"
              ItemsSource="{Binding RunningVms}"
              SelectedItem="{Binding SelectedRunningVm}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              RowHeight="40"
              Margin="8,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="110">
          <DataGridTextColumn.CellStyleClasses>mono</DataGridTextColumn.CellStyleClasses>
        </DataGridTextColumn>
        <DataGridTextColumn Header="STARTED" Binding="{Binding StartedAt, StringFormat='{}{0:HH:mm:ss}'}" Width="120">
          <DataGridTextColumn.CellStyleClasses>mono</DataGridTextColumn.CellStyleClasses>
        </DataGridTextColumn>
        <DataGridTemplateColumn Header="" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="vm:RunningVmRow">
              <StackPanel Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="tool" Content="Stop"
                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).StopVmCommand}"
                        CommandParameter="{Binding}"/>
                <Button Classes="tool danger" Content="Kill"
                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).KillVmCommand}"
                        CommandParameter="{Binding}"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="4"
            Background="{DynamicResource AppRail}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
            Height="26" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="mono" FontSize="10.5" VerticalAlignment="Center"
                   Text="{Binding StatusMessage}"/>
        <TextBlock Grid.Column="1" Classes="mono" FontSize="10.5" VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Text="tracked in-process, not restored after restart"/>
      </Grid>
    </Border>

  </Grid>
</UserControl>
