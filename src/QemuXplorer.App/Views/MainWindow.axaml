<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QemuXplorer.App.ViewModels"
        x:Class="QemuXplorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QemuXplorer"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource AppCanvas}"
        Foreground="{DynamicResource AppText}"
        FontSize="13">

  <Grid ColumnDefinitions="190,*">

    <!-- Left rail -->
    <Border Grid.Column="0"
            Background="{DynamicResource AppRail}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="QEMUXPLORER"
                   FontSize="11" FontWeight="SemiBold" LetterSpacing="1.6"
                   Foreground="{DynamicResource AppText}"
                   Margin="16,18,16,20"/>

        <StackPanel Grid.Row="1" Margin="8,0" Spacing="1">

          <ToggleButton Classes="nav"
                        IsChecked="{Binding IsDashboard, Mode=OneWay}"
                        Command="{Binding NavigateToDashboardCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding $parent[ToggleButton].Foreground}"
                    Data="M3 3h7v9H3V3zm11 0h7v5h-7V3zm0 9h7v9h-7v-9zM3 16h7v5H3v-5z"/>
              <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>

          <ToggleButton Classes="nav"
                        IsChecked="{Binding IsVirtualMachines, Mode=OneWay}"
                        Command="{Binding NavigateToVirtualMachinesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding $parent[ToggleButton].Foreground}"
                    Data="M2 4h20v13H2V4zm2 2v9h16V6H4zm4 15h8v-2H8v2z"/>
              <TextBlock Text="Machines" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>

          <ToggleButton Classes="nav"
                        IsChecked="{Binding IsQemuInstallations, Mode=OneWay}"
                        Command="{Binding NavigateToQemuInstallationsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding $parent[ToggleButton].Foreground}"
                    Data="M4 5h16v2H4V5zm0 6h16v2H4v-2zm0 6h10v2H4v-2z"/>
              <TextBlock Text="Installations" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>

          <ToggleButton Classes="nav"
                        IsChecked="{Binding IsSettings, Mode=OneWay}"
                        Command="{Binding NavigateToSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding $parent[ToggleButton].Foreground}"
                    Data="M12 9a3 3 0 100 6 3 3 0 000-6zm0-7l1.5 2.6 3-.5.5 3L19.5 9l-1.4 2.7 1.9 2.3-2.5 1.8.4 3-3-.4L12 22l-2.9-3.6-3 .4.4-3-2.5-1.8L5.9 11.7 4.5 9l2.5-1.9.5-3 3 .5L12 2z"/>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>

        </StackPanel>

        <!-- Active binary -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0"
                Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="section" Text="DATABASE"/>
            <TextBlock Classes="mono" Text="~/.qemu_explorer" FontSize="10.5"/>
          </StackPanel>
        </Border>

      </Grid>
    </Border>

    <!-- Page host -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

  </Grid>
</Window>
