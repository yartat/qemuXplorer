<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QEmuXlorer.App.ViewModels"
             x:Class="QEmuXlorer.App.Views.VirtualMachinesView"
             x:DataType="vm:VirtualMachinesViewModel">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="Virtual Machines" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <DataGrid Grid.Row="1"
              ItemsSource="{Binding VirtualMachines}"
              SelectedItem="{Binding SelectedVm}"
              IsReadOnly="True"
              AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name"         Binding="{Binding Name}"        Width="*"/>
        <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="120"/>
        <DataGridTextColumn Header="Machine"      Binding="{Binding MachineType}"  Width="80"/>
        <DataGridTextColumn Header="RAM (MB)"     Binding="{Binding Memory.SizeMB}" Width="90"/>
        <DataGridTextColumn Header="Template"     Binding="{Binding IsTemplate}"   Width="80"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Toolbar -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,4">
      <Button Content="Add"   Command="{Binding AddVmCommand}"/>
      <Button Content="Edit"  Click="OnEditClicked"/>
      <Button Content="Clone" Command="{Binding CloneVmCommand}" CommandParameter="{Binding SelectedVm}"/>
      <Button Content="Delete" Command="{Binding DeleteVmCommand}" CommandParameter="{Binding SelectedVm}"/>
      <Button Content="Start" Command="{Binding StartVmCommand}" CommandParameter="{Binding SelectedVm}"/>
      <Button Content="Stop"  Command="{Binding StopVmCommand}"  CommandParameter="{Binding SelectedVm}"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,4,0,0" Foreground="{DynamicResource SystemAccentColor}"/>

  </Grid>
</UserControl>
