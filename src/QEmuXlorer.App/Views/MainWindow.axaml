<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QEmuXlorer.App.ViewModels"
        x:Class="QEmuXlorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QEmuXlorer"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500">

  <Grid ColumnDefinitions="200,*">

    <!-- Left navigation panel -->
    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Margin="8" Spacing="4">
        <TextBlock Text="QEmuXlorer" FontSize="18" FontWeight="Bold" Margin="8,16,8,16"/>

        <Button Command="{Binding NavigateToDashboardCommand}"
                Content="Dashboard"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="12,8"/>

        <Button Command="{Binding NavigateToVirtualMachinesCommand}"
                Content="Virtual Machines"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="12,8"/>

        <Button Command="{Binding NavigateToQemuInstallationsCommand}"
                Content="QEMU Installations"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="12,8"/>

        <Button Command="{Binding NavigateToSettingsCommand}"
                Content="Settings"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="12,8"/>
      </StackPanel>
    </Border>

    <!-- Main content area — rendered via DataTemplates in App.axaml -->
    <ContentControl Grid.Column="1"
                    Content="{Binding CurrentPage}"
                    Margin="0"/>

  </Grid>
</Window>
