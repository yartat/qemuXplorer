<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QEmuXlorer.App.ViewModels"
             x:Class="QEmuXlorer.App.Views.QemuInstallationsView"
             x:DataType="vm:QemuInstallationsViewModel">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="QEMU Installations" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Installations}"
              SelectedItem="{Binding SelectedInstallation}"
              IsReadOnly="True"
              AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"            Width="*"/>
        <DataGridTextColumn Header="Version"  Binding="{Binding DetectedVersion}" Width="80"/>
        <DataGridTextColumn Header="Path"     Binding="{Binding BinaryDirectory}" Width="*"/>
        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}"        Width="90"/>
        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}"   Width="70"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,4">
      <Button Content="Auto-Detect"  Command="{Binding AutoDetectCommand}"/>
      <Button Content="Set Default"  Command="{Binding SetDefaultCommand}" CommandParameter="{Binding SelectedInstallation}"/>
      <Button Content="Remove"       Command="{Binding DeleteCommand}"     CommandParameter="{Binding SelectedInstallation}"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,4,0,0"/>

  </Grid>
</UserControl>
